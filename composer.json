{
    "name": "reynevan/imgw-php",
    "description": "A lightweight, fully typed PHP client for the public IMGW API",
    "autoload": {
        "psr-4": {
            "Reynevan\\Imgw\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Paweł Sumiński",
            "email": "p.suminski@gmail.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.2",
        "php-http/mock-client": "^1.6"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Allows sending HTTP requests via Guzzle (^7.0)",
        "symfony/http-client": "Alternative PSR-18 compatible HTTP client",
        "nyholm/psr7": "Lightweight PSR-7/PSR-17 implementation"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.1"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "test-coverage-html": "phpunit --coverage-html build/coverage",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
